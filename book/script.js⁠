  function updateStats(){
    var total = 0, reading = 0, done = 0, owned = 0, want = 0;
    state.books.forEach(function(b){
      if(b.isStamp || b.isText || b.isSign) return;
      total++;
      if(b.status === 'reading') reading++;
      else if(b.status === 'done') done++;
      else if(b.status === 'want') want++;
      else owned++; 
    });
    document.getElementById('stat-total').textContent = total;
    document.getElementById('stat-reading').textContent = reading;
    document.getElementById('stat-done').textContent = done;
    document.getElementById('stat-owned').textContent = owned;
    document.getElementById('stat-want').textContent = want;
  }

  // ========== 棚のロジック・描画 ==========
  function booksOnShelf(shelfId){
    return state.books.filter(b => b.shelfId === shelfId && !b.isSign && !b.isStamp && !b.isText).sort((a,b) => a.slot - b.slot);
  }
  
  function signsOnShelf(shelfId){
    return state.books.filter(b => b.shelfId === shelfId && b.isSign);
  }
  
  function resolveCollisions(shelfId){
    var arr = booksOnShelf(shelfId);
    var used = {};
    arr.forEach(function(b){
      if (used[b.slot] !== undefined){
        var s = 0; while (used[s] !== undefined) s++;
        b.slot = s;
      }
      used[b.slot] = true;
    });
  }

  function slotWidths(sizes){
    return { cover: sizes.coverW, spine: sizes.spineW };
  }
  function itemGridWidth(book, w){
    if (!book) return w.spine; 
    return (book.displayMode === 'cover' && book.cover) ? w.cover : w.spine;
  }

  function buildItemEl(book, matchPrev, matchNext, sizes){
    var el = document.createElement('div');
    el.className = 'book';
    el.dataset.id = book.id;
    el.style.gridColumn = (book.slot + 1);
    if (selectedItem && selectedItem.id === book.id) el.classList.add('book--picked');

    var authorKey = (book.author && book.author.trim()) ? book.author.trim() : (book.title || book.id);
    var color = SPINE_COLORS[hashStr(authorKey) % SPINE_COLORS.length];
    var sd = statusDef(book.status);

    var bgColor = null, bgLabel = null;
    if (book.bgTag && ((book.tags && book.tags.indexOf(book.bgTag) !== -1) || (book.genres && book.genres.indexOf(book.bgTag) !== -1))) {
      bgColor = tagColor(book.bgTag);
      bgLabel = book.bgTag;
    }
    
    if (bgLabel) {
      var strip = document.createElement('div');
      strip.className = 'book-bg-strip';
      if (matchPrev) strip.classList.add('match-prev');
      if (matchNext) strip.classList.add('match-next');
      strip.style.background = bgColor;
      var stripText = document.createElement('span');
      stripText.textContent = bgLabel;
      strip.appendChild(stripText);
      el.appendChild(strip);
    }

    if (book.displayMode === 'cover' && book.cover) {
      el.classList.add('book--cover');
      el.style.width = sizes.coverW + 'px'; 
      el.style.height = sizes.coverH + 'px';
      var face = document.createElement('div'); face.className = 'cover-face';
      var cimg = document.createElement('img');
      cimg.src = book.cover;
      cimg.onerror = function(){
        face.innerHTML = '<div class="cover-fallback" style="background:' + color + '">'+book.title+'</div>';
      };
      face.appendChild(cimg);
      el.appendChild(face);

      var flag = document.createElement('span');
      flag.className = 'status-flag'; flag.style.color = sd.color;
      el.appendChild(flag);
    } else {
      el.classList.add('book--spine');
      el.style.width = sizes.spineW + 'px'; 
      el.style.height = sizes.spineH + 'px';
      el.style.background = 'linear-gradient(90deg, rgba(0,0,0,.2), transparent 30%), ' + color;
      var t = document.createElement('span'); t.className = 'book-title'; t.textContent = book.title;
      el.appendChild(t);
      var dot = document.createElement('span');
      dot.className = 'status-dot'; dot.style.background = sd.color;
      el.appendChild(dot);
    }
    appendStatusAndMemo(el, book, sd);
    return el;
  }

  function appendStatusAndMemo(el, book, sd) {
    if (book.memo && book.memo.trim()) {
      var memoBadge = document.createElement('span');
      memoBadge.className = 'memo-badge'; memoBadge.textContent = '✎'; memoBadge.title = 'メモあり';
      el.appendChild(memoBadge);
    }
  }

  // ========== 自由配置アイテム（サイン・スタンプ） ==========
  function buildFreeItemEl(fi){
    var el = document.createElement('div');
    el.className = 'free-item';
    el.dataset.id = fi.id;
    el.dataset.kind = fi.isStamp ? 'stamp' : 'text';
    el.style.left = (fi.x * 100) + '%';
    el.style.top = (fi.y * 100) + '%';
    el.style.width = fi.w + 'px';
    el.style.height = fi.h + 'px';
    el.style.transform = 'rotate(' + (fi.rot || 0) + 'deg)';
    
    el.style.zIndex = fi.z || 15;

    if (fi.isStamp){
      var img = document.createElement('img'); img.src = fi.cover; img.draggable = false;
      el.appendChild(img);
    } else {
      var sticker = document.createElement('div');
      sticker.className = 'text-sticker';
      sticker.textContent = fi.title;
      sticker.style.background = fi.color || tagColor(fi.title);
      el.appendChild(sticker);
    }

    if (editMode) attachFreeItemHandles(el, fi);
    return el;
  }

  function attachFreeItemHandles(el, fi){
    var resize = document.createElement('div');
    resize.className = 'resize-handle';
    el.appendChild(resize);
    resize.addEventListener('pointerdown', function(e){
      e.stopPropagation(); e.preventDefault();
      resize.setPointerCapture(e.pointerId);
      var startX = e.clientX, startY = e.clientY, startW = fi.w, startH = fi.h;
      function onMove(ev){
        var dx = ev.clientX - startX, dy = ev.clientY - startY;
        fi.w = Math.max(24, Math.round(startW + dx));
        fi.h = Math.max(24, Math.round(startH + dy));
        el.style.width = fi.w + 'px'; el.style.height = fi.h + 'px';
      }
      function onUp(){
        resize.removeEventListener('pointermove', onMove);
        resize.removeEventListener('pointerup', onUp);
        persist();
      }
      resize.addEventListener('pointermove', onMove);
      resize.addEventListener('pointerup', onUp);
    });

    var rotate = document.createElement('div');
    rotate.className = 'rotate-handle';
    el.appendChild(rotate);
    rotate.addEventListener('pointerdown', function(e){
      e.stopPropagation(); e.preventDefault();
      rotate.setPointerCapture(e.pointerId);
      function angleFromCenter(clientX, clientY){
        var r = el.getBoundingClientRect();
        var cx = r.left + r.width/2, cy = r.top + r.height/2;
        return Math.atan2(clientY - cy, clientX - cx) * 180 / Math.PI + 90;
      }
      function onMove(ev){
        fi.rot = Math.round(angleFromCenter(ev.clientX, ev.clientY));
        el.style.transform = 'rotate(' + fi.rot + 'deg)';
      }
      function onUp(){
        rotate.removeEventListener('pointermove', onMove);
        rotate.removeEventListener('pointerup', onUp);
        persist();
      }
      rotate.addEventListener('pointermove', onMove);
      rotate.addEventListener('pointerup', onUp);
    });
  }

  function renderShelf(){
    if(!document.getElementById('view-bookshelf').classList.contains('active')) return;
    if (state.cases.length === 0) state.cases.push({ id:'c'+(nextCaseNum++), rows:1 });
    casesRow.innerHTML = '';

    state.cases.forEach(function(c){
      var unit = document.createElement('div');
      unit.className = 'bookcase-unit';
      unit.dataset.caseId = c.id;

      if (editingCaseId === c.id) {
        unit.classList.add('is-editing-rows');
      }

      for (var r=0; r<c.rows; r++){
        let shelfId = c.id + '_' + r;
        let rowIndex = r;
        let caseId = c.id;
        var rowWrap = document.createElement('div');
        rowWrap.className = 'shelf-row-wrap';

        var block = document.createElement('div');
        block.className = 'shelf-block';

        var sign = state.shelfSigns[shelfId];
        if (sign){
          var signBar = document.createElement('div');
          signBar.className = 'sign-bar';
          signBar.textContent = sign.text;
          signBar.style.background = sign.color || tagColor(sign.text);
          if (editMode) signBar.addEventListener('click', function(){ openSignEditor(shelfId); });
          block.appendChild(signBar);
        }

        if (editMode) {
          var ctrl = document.createElement('div'); ctrl.className = 'shelf-controls';
          var btn = document.createElement('button');
          btn.textContent = sign ? 'サイン編集' : '+サイン';
          btn.onclick = function(){ openSignEditor(shelfId); };
          ctrl.appendChild(btn); block.appendChild(ctrl);
        }

        var wrap = document.createElement('div');
        wrap.className = 'shelf-books'; wrap.dataset.shelfId = shelfId;
        
        var items = booksOnShelf(shelfId);
        if(items.length===0) wrap.classList.add('empty');
        
        var currentShelfSizes = getShelfSizes(shelfId);
        
        items.forEach(function(item, idx){
          var prev = items[idx - 1];
          var next = items[idx + 1];
          
          var matchPrev = prev && (prev.slot === item.slot - 1) && item.bgTag && (prev.bgTag === item.bgTag);
          var matchNext = next && (next.slot === item.slot + 1) && item.bgTag && (next.bgTag === item.bgTag);

          var el = buildItemEl(item, matchPrev, matchNext, currentShelfSizes);
          attachDragAndClick(el, item);
          wrap.appendChild(el);
        });
        
        block.appendChild(wrap);
        
        var plank = document.createElement('div'); plank.className = 'shelf-plank';
        block.appendChild(plank);

        // ★修正：editModeに関わらず、長押しメニュー用のボタンを常に生成する
        var addBtn = document.createElement('div');
        addBtn.className = 'row-corner-btn add'; addBtn.textContent = '＋'; addBtn.title = 'この下に段を追加';
        var removeBtn = document.createElement('div');
        removeBtn.className = 'row-corner-btn remove'; removeBtn.textContent = '×'; removeBtn.title = 'この段を削除';
        var editBtn = document.createElement('div');
        editBtn.className = 'row-corner-btn edit'; editBtn.textContent = '⚙️'; editBtn.title = 'この段のサイズ設定'; // ★文字化け対策で「⚙️」に変更
        
        block.appendChild(addBtn); 
        block.appendChild(editBtn); 
        block.appendChild(removeBtn);

        rowWrap.appendChild(block);

        if (editMode){
          var handle = document.createElement('div');
          handle.className = 'row-reorder-handle';
          handle.textContent = '≡';
          handle.title = '入れ替え：もう一つ別の段の≡をタップ';
          if (reorderSource === shelfId) handle.classList.add('reorder-source');
          handle.addEventListener('click', function(e){
            e.stopPropagation();
            if (!reorderSource){
              reorderSource = shelfId;
            } else if (reorderSource === shelfId){
              reorderSource = null;
            } else {
              swapShelfContents(reorderSource, shelfId);
              reorderSource = null;
              return; 
            }
            renderShelf();
          });
          rowWrap.insertBefore(handle, block);
        }
        
        // ★修正：editModeに関わらず、長押しイベントを常にアタッチする
        attachRowLongPress(unit, block, caseId, rowIndex, addBtn, removeBtn, editBtn);

        unit.appendChild(rowWrap);
      }

      var freeItems = state.books.filter(b => b.caseId === c.id && (b.isStamp || b.isText));
      if (freeItems.length){
        var freeLayer = document.createElement('div');
        freeLayer.className = 'free-layer';
        freeItems.forEach(function(fi){ freeLayer.appendChild(buildFreeItemEl(fi)); });
        unit.appendChild(freeLayer);
      }

      casesRow.appendChild(unit);
    });

    finalizeGrids();
    updateStats(); 
    if(filterInput.value) applyFilter(); 
  }

  function finalizeGrids(){
    document.querySelectorAll('.shelf-books').forEach(function(el){
      try{
        var shelfId = el.dataset.shelfId;
        var shelfSizes = getShelfSizes(shelfId);
        var w = slotWidths(shelfSizes);
        
        var items = booksOnShelf(shelfId);
        var occ = {};
        items.forEach(function(b){ occ[b.slot] = b; });
        var maxSlot = items.length ? Math.max.apply(null, items.map(b => b.slot)) : -1;
        var cols = Math.max(maxSlot + 2, 4); 
        var widths = [];
        for (var i=0;i<cols;i++) widths.push(itemGridWidth(occ[i], w));
        el.style.gridTemplateColumns = widths.map(x => x+'px').join(' ');
        var offsets = []; var run = 0;
        widths.forEach(function(width){ offsets.push(run); run += width; });
        el._slotOffsets = offsets;
        el._slotWidths = widths;
        el.dataset.cols = cols;
      }catch(err){
        console.error('finalizeGrids failed for a shelf', err);
      }
    });
  }

  function commitMove(item, shelfId, slot){
    var occupant = state.books.find(function(b){
      return b.shelfId === shelfId && b.slot === slot && b.id !== item.id && !b.isStamp && !b.isSign && !b.isText;
    });
    var oldShelfId = item.shelfId, oldSlot = item.slot;
    item.shelfId = shelfId; item.slot = slot;
    if (occupant) { occupant.shelfId = oldShelfId; occupant.slot = oldSlot; }
    persist();
  }

  function slotFromEvent(wrap, clientX){
    var rect = wrap.getBoundingClientRect();
    var cs = getComputedStyle(wrap);
    var padLeft = parseFloat(cs.paddingLeft) || 0;
    var offsets = wrap._slotOffsets || [0];
    var widths = wrap._slotWidths || [30];
    var relX = clientX - rect.left - padLeft + wrap.scrollLeft;
    var slot = offsets.length - 1;
    for (var i=0;i<offsets.length;i++){
      if (relX < offsets[i] + widths[i]){ slot = i; break; }
    }
    return Math.max(0, Math.min(offsets.length - 1, slot));
  }

  function animateDrop(itemId){
    var el = casesRow.querySelector('.book[data-id="' + itemId + '"]') ||
             casesRow.querySelector('.free-item[data-id="' + itemId + '"]');
    if (!el) return;
    var orig = el.style.transform || ''; 
    el.style.transition = 'none';
    el.style.transform = 'translateY(-12px) scale(1.04) ' + orig;
    void el.offsetHeight; 
    el.style.transition = '';
    el.style.transform = orig;
  }

  // ========== 移動: タップして持ち上げ→タップして置く (✥モード時のみ) ==========
  function attachDragAndClick(el, item){
    el.addEventListener('click', function(e){
      if (item.isStamp || item.isSign) return; 

      if (moveMode) {
        if (selectedItem && selectedItem.id === item.id) {
          selectedItem = null; 
          trashArea.classList.remove('show'); 
          renderShelf();
          return;
        }
        if (selectedItem) {
          var picked = selectedItem;
          selectedItem = null;
          trashArea.classList.remove('show'); 
          commitMove(picked, item.shelfId, item.slot);
          renderShelf();
          animateDrop(picked.id);
        } else {
          selectedItem = item;
          trashArea.textContent = 'タップして削除';
          trashArea.classList.add('show');
          renderShelf();
        }
        return;
      }

      if (flipMode) {
        item.displayMode = (item.displayMode === 'cover') ? 'spine' : 'cover';
        persist(); renderShelf();
        return;
      }

      openModal(item);
    });
  }

  document.getElementById('casesRow').addEventListener('click', function(e){
    if (!moveMode || !selectedItem || selectedItem.isSign || selectedItem.isStamp) return;
    var wrap = e.target.closest('.shelf-books');
    if (!wrap || e.target.closest('.book')) return; 
    var shelfId = wrap.dataset.shelfId;
    var slot = slotFromEvent(wrap, e.clientX);
    var picked = selectedItem;
    selectedItem = null;
    trashArea.classList.remove('show'); 
    commitMove(picked, shelfId, slot);
    renderShelf();
    animateDrop(picked.id);
  });

  // ========== スタンプと本の削除・ドラッグ＆ドロップ実装 ==========
  let activeFreeItemNode = null;
  let activeFreeItemData = null;
  let isDraggingFreeItem = false;
  let dragStartX = 0, dragStartY = 0;
  let dragOffsetX = 0, dragOffsetY = 0;
  let hasMovedFreeItem = false;

  trashArea.addEventListener('click', function(e) {
      e.stopPropagation();
      if (moveMode && selectedItem) {
          if (confirm('「' + (selectedItem.title || 'この本') + '」を削除しますか？')) {
              state.books = state.books.filter(b => b.id !== selectedItem.id);
              selectedItem = null;
              trashArea.classList.remove('show');
              persist();
              renderShelf();
          }
      }
  });

  document.addEventListener('pointerdown', function(e) {
      let freeItemNode = e.target.closest('.free-item');
      if (freeItemNode && !e.target.closest('.resize-handle, .rotate-handle')) {
          e.stopPropagation(); 
          
          if (activeFreeItemNode && activeFreeItemNode !== freeItemNode) {
              activeFreeItemNode.classList.remove('active');
          }

          activeFreeItemNode = freeItemNode;
          let fiId = freeItemNode.dataset.id;
          activeFreeItemData = state.books.find(b => b.id === fiId);

          globalStampZ++;
          activeFreeItemData.z = globalStampZ;
          activeFreeItemNode.style.zIndex = globalStampZ;

          if (freeItemNode.classList.contains('active')) {
              isDraggingFreeItem = true;
              hasMovedFreeItem = false;
              let rect = freeItemNode.getBoundingClientRect();
              dragOffsetX = e.clientX - rect.left;
              dragOffsetY = e.clientY - rect.top;
              dragStartX = e.clientX;
              dragStartY = e.clientY;
              trashArea.textContent = 'ここにドロップして削除';
              trashArea.classList.add('show');
              freeItemNode.setPointerCapture(e.pointerId);
          } else {
              freeItemNode.classList.add('active');
              trashArea.textContent = 'ドラッグ移動・ここにドロップで削除';
              trashArea.classList.add('show');
          }
      } else {
          if (activeFreeItemNode && !e.target.closest('#trash-area')) {
              activeFreeItemNode.classList.remove('active');
              activeFreeItemNode = null;
              activeFreeItemData = null;
              trashArea.classList.remove('show');
              persist(); 
          }
      }
  });

  document.addEventListener('pointermove', function(e) {
      if (isDraggingFreeItem && activeFreeItemNode) {
          let dx = e.clientX - dragStartX;
          let dy = e.clientY - dragStartY;
          if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
              hasMovedFreeItem = true;
          }
          if (hasMovedFreeItem) {
              e.preventDefault();
              let x = e.clientX - dragOffsetX;
              let y = e.clientY - dragOffsetY;
              activeFreeItemNode.style.position = 'fixed';
              activeFreeItemNode.style.left = x + 'px';
              activeFreeItemNode.style.top = y + 'px';
          }
      }
  }, {passive: false});

  document.addEventListener('pointerup', function(e) {
      if (isDraggingFreeItem && activeFreeItemNode) {
          activeFreeItemNode.releasePointerCapture(e.pointerId);
          let trashRect = trashArea.getBoundingClientRect();
          
          if (e.clientY >= trashRect.top && hasMovedFreeItem) {
              state.books = state.books.filter(b => b.id !== activeFreeItemData.id);
              activeFreeItemNode.remove();
              activeFreeItemNode = null;
              activeFreeItemData = null;
              trashArea.classList.remove('show');
              persist();
          } else {
              if (hasMovedFreeItem) {
                  activeFreeItemNode.style.display = 'none';
                  let dropTarget = document.elementFromPoint(e.clientX, e.clientY);
                  activeFreeItemNode.style.display = '';

                  let unit = dropTarget ? dropTarget.closest('.bookcase-unit') : null;
                  if (!unit) {
                      unit = document.querySelector('.bookcase-unit[data-case-id="' + activeFreeItemData.caseId + '"]');
                  }
                  
                  if (unit) {
                      let uRect = unit.getBoundingClientRect();
                      let absLeft = e.clientX - dragOffsetX;
                      let absTop = e.clientY - dragOffsetY;
                      let relX = (absLeft - uRect.left) / uRect.width;
                      let relY = (absTop - uRect.top) / uRect.height;

                      activeFreeItemData.caseId = unit.dataset.caseId;
                      activeFreeItemData.x = relX;
                      activeFreeItemData.y = relY;

                      let freeLayer = unit.querySelector('.free-layer');
                      if (!freeLayer) {
                          freeLayer = document.createElement('div');
                          freeLayer.className = 'free-layer';
                          unit.appendChild(freeLayer);
                      }
                      freeLayer.appendChild(activeFreeItemNode);
                      
                      activeFreeItemNode.style.position = 'absolute';
                      activeFreeItemNode.style.left = (relX * 100) + '%';
                      activeFreeItemNode.style.top = (relY * 100) + '%';
                  }
                  persist();
              } else {
                  if (activeFreeItemData && activeFreeItemData.isText && editMode) {
                      let next = prompt('テキストを編集（空にすると削除）', activeFreeItemData.title || '');
                      if (next !== null) {
                          if (!next.trim()) {
                              state.books = state.books.filter(b => b.id !== activeFreeItemData.id);
                              activeFreeItemNode.remove();
                              activeFreeItemNode = null;
                              activeFreeItemData = null;
                              trashArea.classList.remove('show');
                          } else {
                              activeFreeItemData.title = next.trim();
                              activeFreeItemData.color = tagColor(activeFreeItemData.title);
                              let sticker = activeFreeItemNode.querySelector('.text-sticker');
                              if (sticker) {
                                  sticker.textContent = activeFreeItemData.title;
                                  sticker.style.background = activeFreeItemData.color;
                              }
                          }
                          persist();
                      }
                  }
              }
          }
          isDraggingFreeItem = false;
      }
  });


  // ========== モーダル (詳細/編集) ==========
  var curItem = null;
  
  function updateTagSelects() {
    var gSel = document.getElementById('bm-genre-select');
    gSel.innerHTML = '<option value="">＋ ジャンル...</option>';
    state.genreHistory.forEach(function(g) {
      gSel.innerHTML += '<option value="' + g + '">' + g + '</option>';
    });
    gSel.innerHTML += '<option value="__NEW__">＋ 新規作成...</option>';

    var tSel = document.getElementById('bm-tag-select');
    tSel.innerHTML = '<option value="">＋ タグ...</option>';
    state.tagHistory.forEach(function(t) {
      tSel.innerHTML += '<option value="' + t + '">' + t + '</option>';
    });
    tSel.innerHTML += '<option value="__NEW__">＋ 新規作成...</option>';
  }

  function handleTagSelectChange(e, type) {
    var val = e.target.value;
    e.target.value = ''; 
    if (!val || !curItem) return;

    if (val === '__NEW__') {
      val = prompt('新しい' + (type === 'genre' ? 'ジャンル' : 'タグ') + 'を入力してください');
      if (!val || !val.trim()) return;
      val = val.trim();
      
      var history = type === 'genre' ? state.genreHistory : state.tagHistory;
      var idx = history.indexOf(val);
      if (idx !== -1) history.splice(idx, 1);
      history.unshift(val);
      if (history.length > 50) history.length = 50;
      persist();
      updateTagSelects(); 
    }

    var targetList = type === 'genre' ? (curItem.genres = curItem.genres || []) : (curItem.tags = curItem.tags || []);
    if (!targetList.includes(val)) {
      targetList.push(val);
      persist();
      refreshTagUI(curItem);
      renderShelf();
    }
  }

  document.getElementById('bm-genre-select').addEventListener('change', function(e){ handleTagSelectChange(e, 'genre'); });
  document.getElementById('bm-tag-select').addEventListener('change', function(e){ handleTagSelectChange(e, 'tag'); });

  function openModal(item){
    curItem = item;
    var modal = document.getElementById('bookModal');

    if (editMode) modal.classList.add('is-edit');
    else modal.classList.remove('is-edit');

    document.getElementById('bm-title').textContent = item.title;

    var coverWrap = document.getElementById('bm-cover-wrap');
    coverWrap.innerHTML = '';
    if (item.cover) {
      var img = document.createElement('img'); img.src = item.cover; coverWrap.appendChild(img);
    }
    document.getElementById('bm-cover-input').value = item.cover || '';

    var synEl = document.getElementById('bm-synopsis');
    var synInput = document.getElementById('bm-synopsis-input');
    var synToggle = document.getElementById('bm-synopsis-toggle');
    
    synEl.textContent = item.description || '（あらすじ情報はありません）';
    synInput.value = item.description || '';
    
    synEl.classList.remove('expanded'); synToggle.hidden = true; synToggle.textContent = '続きを読む';
    requestAnimationFrame(() => { if (synEl.scrollHeight > synEl.clientHeight + 4) synToggle.hidden = false; });

    var googleImgLink = document.getElementById('bm-google-img');
    googleImgLink.href = 'https://www.google.com/search?tbm=isch&q=' + encodeURIComponent((item.title || '') + ' ' + (item.author || '') + ' 表紙');

    var hanmotoLink = document.getElementById('bm-hanmoto-link');
    if (item.isbn) {
        hanmotoLink.href = 'https://www.hanmoto.com/bd/isbn/' + item.isbn;
        hanmotoLink.style.display = 'inline-block';
    } else hanmotoLink.style.display = 'none';

    var descLink = document.getElementById('bm-google-desc');
    descLink.href = 'https://www.google.com/search?q=' + encodeURIComponent((item.title || '') + ' ' + (item.author || '') + ' あらすじ');

    document.getElementById('bm-author').textContent = item.author ? '著者: ' + item.author : '著者: （情報なし）';
    document.getElementById('bm-publisher').textContent = item.publisher ? '出版社: ' + item.publisher : '出版社: （情報なし）';
    document.getElementById('bm-isbn').textContent = item.isbn ? 'ISBN: ' + item.isbn : 'ISBN: （情報なし）';

    document.getElementById('bm-memo').value = item.memo || '';
    document.getElementById('bm-memo-text').textContent = item.memo || 'メモはありません';

    var statusEl = document.getElementById('bm-status');
    if(statusEl) statusEl.value = item.status || 'owned';
    
    updateTagSelects(); 
    
    refreshTagUI(item);
    modal.classList.remove('hidden');
  }

  function renderDetailTags(item){
    var wrap = document.getElementById('bm-tags'); wrap.innerHTML = '';
    
    var allTags = [];
    (item.genres || []).forEach(g => allTags.push({text: g, type: 'genre'}));
    (item.tags || []).forEach(t => allTags.push({text: t, type: 'tag'}));

    allTags.forEach(function(tagObj){
      var tag = tagObj.text;
      var chip = document.createElement('span'); 
      chip.className = 'tag-chip' + (tagObj.type === 'genre' ? ' genre-chip' : ''); 

      var swatch = document.createElement('input');
      swatch.type = 'color';
      swatch.className = 'tag-swatch';
      swatch.value = tagColor(tag);
      swatch.title = '「' + tag + '」の背景色';
      swatch.disabled = !editMode;
      swatch.addEventListener('input', function(){
        state.tagColors[tag] = this.value;
        persist(); renderDetailTags(item); renderShelf();
      });
      chip.appendChild(swatch);

      var txt = document.createElement('span'); 
      txt.textContent = tag;
      chip.appendChild(txt);
      if (item.bgTag === tag){
        var star = document.createElement('span'); star.className='bgtag-star'; star.textContent='★';
        star.title = 'この本の背景マークに設定中';
        chip.appendChild(star);
      }

      if(editMode){
        var rm = document.createElement('button'); rm.textContent = '×';
        rm.onclick = function(){
          if(tagObj.type === 'genre') item.genres = item.genres.filter(t => t !== tag);
          else item.tags = item.tags.filter(t => t !== tag);
          if (item.bgTag === tag) item.bgTag = null;
          persist(); refreshTagUI(item); renderShelf();
        };
        chip.appendChild(rm);
      }
      wrap.appendChild(chip);
    });
  }

  function refreshBgTagSelect(item){
    var sel = document.getElementById('bm-bgtag');
    sel.innerHTML = '<option value="">背景マーク: なし</option>';
    
    var allTags = [].concat(item.genres || [], item.tags || []);
    allTags.forEach(function(t){
      var opt = document.createElement('option'); opt.value = t; opt.textContent = t;
      if (item.bgTag === t) opt.selected = true;
      sel.appendChild(opt);
    });
  }
  function refreshTagUI(item){
    renderDetailTags(item);
    refreshBgTagSelect(item);
  }
  document.getElementById('bm-bgtag').addEventListener('change', function(){
    if (!curItem) return;
    curItem.bgTag = this.value || null;
    persist(); renderDetailTags(curItem); renderShelf();
  });

  document.getElementById('bm-synopsis-toggle').addEventListener('click', function(){
    var synEl = document.getElementById('bm-synopsis');
    var expanded = synEl.classList.toggle('expanded');
    this.textContent = expanded ? '閉じる' : '続きを読む';
  });

  document.getElementById('bm-close').addEventListener('click', function(){
    if(curItem){
      curItem.memo = document.getElementById('bm-memo').value;
      if(editMode){
        curItem.description = document.getElementById('bm-synopsis-input').value;
        curItem.cover = document.getElementById('bm-cover-input').value;
        var st = document.getElementById('bm-status');
        if(st) curItem.status = st.value;
      }
      persist(); renderShelf();
    }
    document.getElementById('bookModal').classList.add('hidden');
  });
  
  document.getElementById('bm-delete').addEventListener('click', function(){
    if(curItem && confirm('削除しますか？')){
      state.books = state.books.filter(b => b.id !== curItem.id);
      persist(); renderShelf();
      document.getElementById('bookModal').classList.add('hidden');
    }
  });

  document.getElementById('bm-memo').addEventListener('input', function(){
    if(curItem){ curItem.memo = this.value; document.getElementById('bm-memo-text').textContent = curItem.memo || 'メモはありません'; persist(); }
  });
  document.getElementById('bm-synopsis-input').addEventListener('input', function(){
    if(curItem){ curItem.description = this.value; document.getElementById('bm-synopsis').textContent = curItem.description || '（あらすじ情報はありません）'; persist(); }
  });
  document.getElementById('bm-cover-input').addEventListener('change', function(){
    if(curItem){
      curItem.cover = this.value.trim(); persist();
      var wrap = document.getElementById('bm-cover-wrap'); wrap.innerHTML = '';
      if(curItem.cover){ var img = document.createElement('img'); img.src = curItem.cover; wrap.appendChild(img); }
    }
  });

  // ========== 検索・一括追加ロジック ==========
  var scanStream = null;
  var scanning = false;
  
  document.getElementById('modeScanBtn').addEventListener('click', function(){
    this.classList.remove('ghost'); document.getElementById('modeInputBtn').classList.add('ghost');
    document.getElementById('scanArea').hidden = false; document.getElementById('inputArea').hidden = true;
    startScan();
  });
  document.getElementById('modeInputBtn').addEventListener('click', function(){
    this.classList.remove('ghost'); document.getElementById('modeScanBtn').classList.add('ghost');
    document.getElementById('scanArea').hidden = true; document.getElementById('inputArea').hidden = false;
    stopScan();
  });

  function renderQueue(){
    document.getElementById('queueCount').textContent = searchQueue.length;
    var list = document.getElementById('queueList'); list.innerHTML = '';
    searchQueue.forEach(function(q, i){
      var d = document.createElement('div'); d.className = 'queue-item';
      var img = document.createElement('img'); img.src = q.cover || ''; img.onerror = function(){ this.style.display='none'; };
      var info = document.createElement('div'); info.className = 'queue-info';
      info.innerHTML = '<div class="queue-title">'+(q.title||'無題')+'</div><div class="queue-author">'+(q.author||'')+'</div>';
      var del = document.createElement('button'); del.className = 'queue-del'; del.textContent = '×';
      del.onclick = function(){ searchQueue.splice(i,1); renderQueue(); };
      d.appendChild(img); d.appendChild(info); d.appendChild(del); list.appendChild(d);
    });
  }

  async function fetchBookInfo(query){
    var isIsbn = /^[0-9Xx]+$/.test(query.replace(/-/g,''));
    var resObj = { title: '', author: '', publisher: '', cover: '', description: '', displayMode: 'cover', size: 'm', tags: [], genres: [], status: 'owned', bgTag: null };
    
    if (isIsbn) {
      var isbn = query.replace(/-/g,''); resObj.isbn = isbn;
      try {
        var res = await fetch('https://api.openbd.jp/v1/get?isbn=' + isbn);
        var data = await res.json();
        if(data && data[0]){
          var s = data[0].summary;
          resObj.title = s.title; resObj.author = (s.author||'').replace(/\/+$/,'');
          resObj.publisher = s.publisher; resObj.cover = s.cover;
        }
      } catch(e) {}

      if(!resObj.cover || !resObj.title){
        try{
           var gRes = await fetch('https://www.googleapis.com/books/v1/volumes?q=isbn:' + isbn);
           var gData = await gRes.json();
           var info = gData.items?.[0]?.volumeInfo;
           if(info){
              if(!resObj.title) resObj.title = info.title;
              if(!resObj.author) resObj.author = info.authors?.join(', ');
              if(!resObj.cover) resObj.cover = info.imageLinks?.thumbnail?.replace('http:','https:');
              if(!resObj.description) resObj.description = info.description;
           }
        }catch(e){}
      }
      if(!resObj.cover) resObj.cover = 'https://www.hanmoto.com/bd/img/'+isbn+'.jpg';
      if(!resObj.title) resObj.title = '未登録本 (ISBN:'+isbn+')';
      return resObj;
    } else {
      try {
        var gRes2 = await fetch('https://www.googleapis.com/books/v1/volumes?q=intitle:' + encodeURIComponent(query));
        var gData2 = await gRes2.json();
        if(gData2.items && gData2.items.length > 0){
          var info2 = gData2.items[0].volumeInfo;
          resObj.title = info2.title || query;
          resObj.author = info2.authors?.join(', ') || '';
          resObj.publisher = info2.publisher || '';
          resObj.cover = info2.imageLinks?.thumbnail?.replace('http:','https:') || '';
          resObj.description = info2.description || '';
        } else resObj.title = query + ' (情報なし)';
      } catch(e) { resObj.title = query; }
      return resObj;
    }
  }

  document.getElementById('manualSearchBtn').addEventListener('click', async function(){
    var val = document.getElementById('manualIsbn').value.trim();
    if(!val) return;
    this.disabled = true; this.textContent = '...';
    var info = await fetchBookInfo(val);
    searchQueue.push(info); renderQueue();
    document.getElementById('manualIsbn').value = '';
    this.disabled = false; this.textContent = '検索';
  });

  document.getElementById('bulkAddBtn').addEventListener('click', function(){
    if(searchQueue.length === 0) return showToast('追加する本がありません');
    var sid = state.cases[0].id + '_0'; 
    searchQueue.forEach(function(q){
      var siblings = booksOnShelf(sid);
      var b = Object.assign({}, q, { id:uid(), shelfId:sid, slot: siblings.length });
      state.books.push(b);
    });
    persist(); searchQueue = []; renderQueue(); showToast('本棚に追加しました！');
    document.querySelector('.nav-btn[data-target="view-bookshelf"]').click();
  });

  // ---------- カメラ ----------
  var lastScanned = '';
  function startScan(){
    if(scanning) return;
    scanning = true; lastScanned = '';
    Quagga.init({
      inputStream: { type: 'LiveStream', target: document.getElementById('scanContainer'), constraints: { facingMode: 'environment' } },
      decoder: { readers: ['ean_reader'] }
    }, function(err){
      if(err) { scanning=false; return showToast('カメラが起動できません'); }
      Quagga.start();
    });
    Quagga.onDetected(async function(res){
      var code = res.codeResult.code;
      if(code !== lastScanned && /^978/.test(code)){
        lastScanned = code; showToast(code + ' 読取完了');
        var info = await fetchBookInfo(code);
        searchQueue.push(info); renderQueue();
        setTimeout(()=> { lastScanned = ''; }, 3000); 
      }
    });
  }
  function stopScan(){ if(scanning) { Quagga.stop(); scanning = false; } }

  // ========== 初期化 ==========
  loadState();
  applyPopStage();
  renderShelf();

})();
</script>
