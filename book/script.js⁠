  document.getElementById('stampMenuClose').addEventListener('click', function(){
    stampMenu.classList.add('hidden');
  });
  document.getElementById('stampMenuFile').addEventListener('click', function(){
    stampMenu.classList.add('hidden');
    document.getElementById('stampFileInput').click();
