(function(){
  "use strict";

  // ========== 状態と定数 ==========
  var STATUS_DEFS = [
    { key:'want',    label:'欲しい',   color:'#3a4e6e' },
    { key:'owned',   label:'購入済み', color:'#a87c3f' },
    { key:'reading', label:'読み中',   color:'#445c42' },
    { key:'done',    label:'済',       color:'#6b5b45' }
  ];
  function statusDef(key){
    for (var i=0; i<STATUS_DEFS.length; i++) if (STATUS_DEFS[i].key === key) return STATUS_DEFS[i];
    return STATUS_DEFS[1]; 
  }

  var state = {
    cases: [ { id:'c1', rows:1 } ],
    books: [],   
    theme: 'default',
    coverCount: 4, 
    spineCount: 12, 
    tagColors: {}, 
    signHistory: [], 
    shelfSigns: {}, 
    stampHistory: [],
    tagHistory: [], 
    genreHistory: [], 
    shelfSettings: {} 
  };
  var searchQueue = []; 
  var editMode = false;
  var flipMode = false;
  var moveMode = false;
  var selectedItem = null; 
  var nextCaseNum = 2;

  var globalStampZ = 200; 

  var editingCaseId = null; 
  var ignoreNextClick = false; 

  document.addEventListener('pointerdown', function(e){
    if (editingCaseId) {
      if (ignoreNextClick) return; 
      if (e.target.closest('.row-corner-btn')) return; 
      
      editingCaseId = null;
      renderShelf(); 
    }
  }, true);

  var SPINE_COLORS = ['#7b3f3f','#3e5c55','#3a4e6e','#6b5b3e','#4b3b57','#5c6b3e','#7a4b2e','#39424e','#8b5e3c','#4e4b7b'];
  var TAG_PALETTE = ['#c0392b','#2d6a4f','#5b3a8e','#1f5f9e','#b5651d','#2f6f62','#8e3a5c','#39546e'];
  function tagColor(tag){
    return (state.tagColors && state.tagColors[tag]) || TAG_PALETTE[hashStr(tag) % TAG_PALETTE.length];
  }

  function uid(){ return 'i'+Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
  function hashStr(str){
    var h=5381; for(var i=0;i<str.length;i++){ h=((h<<5)+h)+str.charCodeAt(i); h|=0; } return Math.abs(h);
  }

  // ========== データ保存・復元・サイズ計算 ==========
  function loadState(){
    try{
      var res = localStorage.getItem('bookshelf-v7'); 
      if (res) {
        var p = JSON.parse(res);
        state.cases = p.cases || [{id:'c1', rows:1}];
        var legacyRowCount = p.rowCount;
        state.cases = state.cases.map(function(c){
          if (c.rows === undefined) c.rows = legacyRowCount || 1;
          return c;
        });
        if (state.cases.length === 0) state.cases = [{id:'c1', rows:1}];
        state.books = p.books || [];
        state.theme = p.theme || 'default';
        state.coverCount = p.coverCount || 4;
        state.spineCount = p.spineCount || 12;
        state.tagColors = p.tagColors || {};
        state.signHistory = p.signHistory || [];
        state.shelfSigns = p.shelfSigns || {};
        state.stampHistory = p.stampHistory || [];
        state.tagHistory = p.tagHistory || []; 
        state.genreHistory = p.genreHistory || []; 
        state.shelfSettings = p.shelfSettings || {}; 
        
        state.books = state.books.filter(function(b){
          if (b.isSign){
            if (!state.shelfSigns[b.shelfId]){
              state.shelfSigns[b.shelfId] = { text: b.title, color: b.color || tagColor(b.title) };
            }
            return false;
          }
          return true;
        });
        
        state.books.forEach(function(b){
          if ((b.isStamp || b.isText) && !b.caseId && b.shelfId){
            var m = /^(.*)_(\d+)$/.exec(b.shelfId);
            b.caseId = m ? m[1] : state.cases[0].id;
            var rowIndex = m ? parseInt(m[2],10) : 0;
            b.y = Math.min(0.9, (b.y || 0.05) + rowIndex * 0.12);
            delete b.shelfId;
          }
          if (b.z && b.z > globalStampZ) globalStampZ = b.z;
        });
        nextCaseNum = state.cases.length + 1;
      }
    }catch(e){}
    applyTheme(state.theme);
    
    document.getElementById('inpCoverCount').value = state.coverCount;
    document.getElementById('lblCoverCount').textContent = state.coverCount + ' 冊';
    document.getElementById('inpSpineCount').value = state.spineCount;
    document.getElementById('lblSpineCount').textContent = state.spineCount + ' 冊';
    
    updateBookSizes();
  }
  function persist(){
    localStorage.setItem('bookshelf-v7', JSON.stringify(state));
  }

  var currentSizes = { coverW: 90, coverH: 135, spineW: 30, spineH: 135, stampW: 63 };
  function updateBookSizes() {
    var shelfW = Math.min(window.innerWidth * 0.92, 560) - 24 - 20; 
    if(shelfW < 200) shelfW = 300; 
    
    var coverW = Math.max(30, Math.floor(shelfW / state.coverCount));
    var spineW = Math.max(10, Math.floor(shelfW / state.spineCount));
    var coverH = Math.floor(coverW * 1.5);
    var spineH = coverH;
    currentSizes = { coverW: coverW, coverH: coverH, spineW: spineW, spineH: spineH, stampW: Math.floor(coverW * 0.7) };
    
    var styleEl = document.getElementById('dynamicStyles');
    styleEl.textContent = `
      :root {
        --stamp-w: ${currentSizes.stampW}px;
      }
      .book--stamp { width: var(--stamp-w); height: var(--stamp-w); }
    `;
  }

  function getShelfSizes(shelfId) {
    var shelfW = Math.min(window.innerWidth * 0.92, 560) - 24 - 20; 
    if(shelfW < 200) shelfW = 300; 
    
    var cCount = state.coverCount;
    var sCount = state.spineCount;

    if (state.shelfSettings && state.shelfSettings[shelfId]) {
      cCount = state.shelfSettings[shelfId].coverCount;
      sCount = state.shelfSettings[shelfId].spineCount;
    }

    var coverW = Math.max(30, Math.floor(shelfW / cCount));
    var spineW = Math.max(10, Math.floor(shelfW / sCount));
    var coverH = Math.floor(coverW * 1.5);
    var spineH = coverH;

    return { coverW: coverW, coverH: coverH, spineW: spineW, spineH: spineH };
  }
  
  document.getElementById('inpCoverCount').addEventListener('input', function(){
    state.coverCount = parseInt(this.value, 10);
    document.getElementById('lblCoverCount').textContent = state.coverCount + ' 冊';
    updateBookSizes(); renderShelf(); persist();
  });
  document.getElementById('inpSpineCount').addEventListener('input', function(){
    state.spineCount = parseInt(this.value, 10);
    document.getElementById('lblSpineCount').textContent = state.spineCount + ' 冊';
    updateBookSizes(); renderShelf(); persist();
  });
  window.addEventListener('resize', function(){
    updateBookSizes(); renderShelf();
  });

  // ========== UI制御 ==========
  var toastEl = document.getElementById('toast');
  var toastTimer = null;
  function showToast(msg){
    toastEl.textContent = msg; toastEl.classList.remove('hidden');
    clearTimeout(toastTimer); toastTimer = setTimeout(function(){ toastEl.classList.add('hidden'); }, 2500);
  }

  function applyTheme(theme) {
    if (theme === 'default') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', theme);
  }

  var sidebarOverlay = document.getElementById('sidebarOverlay');
  var sidebarMenu = document.getElementById('sidebarMenu');
  
  document.getElementById('menuBtn').addEventListener('click', function(){
    sidebarOverlay.classList.add('open'); sidebarMenu.classList.add('open');
  });
  sidebarOverlay.addEventListener('click', function(){
    sidebarOverlay.classList.remove('open'); sidebarMenu.classList.remove('open');
  });

  document.querySelectorAll('.nav-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      var targetId = this.dataset.target;
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      document.getElementById(targetId).classList.add('active');
      
      document.getElementById('headerTitle').textContent = this.textContent.replace(/[📚🔍⚙️]\s*/,'');
      document.getElementById('bookshelfIcons').style.display = (targetId === 'view-bookshelf') ? 'flex' : 'none';
      document.getElementById('searchIcons').style.display = (targetId === 'view-search') ? 'flex' : 'none';

      if(targetId !== 'view-search') stopScan();
      if(targetId === 'view-bookshelf') renderShelf();
      
      sidebarOverlay.classList.remove('open'); sidebarMenu.classList.remove('open');
    });
  });

  document.querySelectorAll('.theme-btn[data-set-theme]').forEach(function(btn){
    btn.addEventListener('click', function(){
      state.theme = this.dataset.setTheme; applyTheme(state.theme); persist();
      showToast('テーマを変更しました');
      sidebarOverlay.classList.remove('open'); sidebarMenu.classList.remove('open');
    });
  });
  document.getElementById('clearHistoryBtn').addEventListener('click', function(){
    if (!confirm('スタンプ・サインの履歴を消去しますか？（配置済みのものは消えません）')) return;
    state.stampHistory = [];
    state.signHistory = [];
    state.tagHistory = []; 
    state.genreHistory = [];
    state.shelfSettings = {}; 
    persist();
    showToast('履歴を消去しました');
    sidebarOverlay.classList.remove('open'); sidebarMenu.classList.remove('open');
  });

  document.getElementById('exportDataBtn').addEventListener('click', function(){
    var dataStr = JSON.stringify(state);
    var blob = new Blob([dataStr], {type: "application/json"});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = "bookshelf_backup_" + new Date().toISOString().slice(0,10) + ".json";
    a.click();
    URL.revokeObjectURL(url);
    showToast('バックアップを保存しました');
  });
  
  document.getElementById('importDataBtn').addEventListener('click', function(){
    document.getElementById('importFileInput').click();
  });
  
  document.getElementById('importFileInput').addEventListener('change', function(e){
    var file = e.target.files[0];
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(ev){
      try {
        var p = JSON.parse(ev.target.result);
        if(!p || !p.cases || !p.books) throw new Error("Invalid format");
        state = p;
        persist();
        loadState();
        renderShelf();
        showToast('データを復元しました');
        sidebarOverlay.classList.remove('open'); sidebarMenu.classList.remove('open');
      } catch(err) {
        showToast('エラー: 正しいバックアップファイルではありません');
      }
    };
    reader.readAsText(file);
    this.value = ''; 
  });

  // ========== 本棚の機能 ==========
  var casesRow = document.getElementById('casesRow');
  var paginationDots = document.getElementById('paginationDots');
  var scrollTimeout;
  const trashArea = document.getElementById('trash-area');
  
  document.getElementById('toggleEditBtn').addEventListener('click', function(){
    editMode = !editMode;
    this.classList.toggle('active', editMode);
    document.getElementById('editTools').style.display = editMode ? 'flex' : 'none';
    renderShelf();
  });

  document.getElementById('toggleMoveBtn').addEventListener('click', function(){
    moveMode = !moveMode;
    this.classList.toggle('active', moveMode);
    selectedItem = null;
    trashArea.classList.remove('show');
    renderShelf();
  });

  var popStage = 3; 
  var POP_STAGE_OPACITY = [0.35, 0.6, 0.8, 1];
  function applyPopStage(){
    var hideSigns = (popStage === 0 || popStage === 2);
    var hideStamps = (popStage === 0 || popStage === 1);
    casesRow.classList.toggle('hide-signs', hideSigns);
    casesRow.classList.toggle('hide-stamps', hideStamps);
    var btn = document.getElementById('togglePopBtn');
    btn.style.opacity = POP_STAGE_OPACITY[popStage];
    btn.classList.toggle('pop-all-hidden', popStage === 0);
  }
  document.getElementById('togglePopBtn').addEventListener('click', function(){
    popStage = (popStage + 1) % 4;
    applyPopStage();
  });

  document.getElementById('flipModeBtn').addEventListener('click', function(){
    flipMode = !flipMode;
    this.textContent = '表示切替(表紙/背): ' + (flipMode ? 'ON' : 'OFF');
    this.classList.toggle('ghost', !flipMode);
  });

  var filterBar = document.getElementById('filterBar');
  var filterInput = document.getElementById('filterInput');
  document.getElementById('toggleFilterBtn').addEventListener('click', function(){
    var isHidden = filterBar.style.display === 'none';
    filterBar.style.display = isHidden ? 'block' : 'none';
    this.classList.toggle('active', !isHidden);
    if(isHidden) {
      filterInput.focus();
    } else {
      filterInput.value = '';
      applyFilter();
    }
  });
  filterInput.addEventListener('input', applyFilter);
  function applyFilter(){
    var q = filterInput.value.trim().toLowerCase();
    if(!q){
      casesRow.classList.remove('is-filtered');
      casesRow.querySelectorAll('.book').forEach(function(el){ el.classList.remove('matched'); });
      return;
    }
    casesRow.classList.add('is-filtered');
    state.books.forEach(function(b){
      if(b.isStamp || b.isText || b.isSign) return;
      var el = casesRow.querySelector('.book[data-id="'+b.id+'"]');
      if(!el) return;
      var textToSearch = (b.title + ' ' + (b.author||'') + ' ' + (b.genres?b.genres.join(' '):'') + ' ' + (b.tags?b.tags.join(' '):'')).toLowerCase();
      if(textToSearch.indexOf(q) !== -1){
        el.classList.add('matched');
      } else {
        el.classList.remove('matched');
      }
    });
  }

  document.getElementById('addCaseBtnHeader').addEventListener('click', function(){
    addCase();
  });

  function shelfIdsInCase(caseId){
    var c = state.cases.find(x => x.id === caseId);
    var ids = [];
    if (c) for (var r=0; r<c.rows; r++) ids.push(caseId + '_' + r);
    return ids;
  }
  function addRowBelow(caseId, rowIndex){
    var c = state.cases.find(x => x.id === caseId);
    if (!c) return;
    for (var r=c.rows-1; r>rowIndex; r--){
      var oldId = caseId+'_'+r, newId = caseId+'_'+(r+1);
      state.books.forEach(function(b){ if (b.shelfId===oldId) b.shelfId=newId; });
      if (state.shelfSigns[oldId]){ state.shelfSigns[newId]=state.shelfSigns[oldId]; delete state.shelfSigns[oldId]; }
      if (state.shelfSettings[oldId]) { state.shelfSettings[newId] = state.shelfSettings[oldId]; delete state.shelfSettings[oldId]; }
    }
    c.rows++;
    persist(); renderShelf();
  }
  function deleteCaseRow(caseId, rowIndex){
    var c = state.cases.find(x => x.id === caseId);
    if (!c) return;
    if (c.rows <= 1){
      if (state.cases.length <= 1){
        showToast('これ以上段を減らせません');
        return;
      }
      deleteCase(caseId);
      return;
    }
    var shelfId = caseId+'_'+rowIndex;
    var hasItems = state.books.some(b => b.shelfId===shelfId) || !!state.shelfSigns[shelfId];
    if (hasItems && !confirm('この段のアイテムも削除されます。よろしいですか？')) return;
    state.books = state.books.filter(b => b.shelfId !== shelfId);
    delete state.shelfSigns[shelfId];
    delete state.shelfSettings[shelfId]; 

    for (var r=rowIndex+1; r<c.rows; r++){
      var oldId = caseId+'_'+r, newId = caseId+'_'+(r-1);
      state.books.forEach(function(b){ if (b.shelfId===oldId) b.shelfId=newId; });
      if (state.shelfSigns[oldId]){ state.shelfSigns[newId]=state.shelfSigns[oldId]; delete state.shelfSigns[oldId]; }
      if (state.shelfSettings[oldId]) { state.shelfSettings[newId] = state.shelfSettings[oldId]; delete state.shelfSettings[oldId]; }
    }
    c.rows--;
    persist(); renderShelf();
  }
  function swapShelfContents(shelfIdA, shelfIdB){
    if (shelfIdA === shelfIdB) return;
    var tmp = '__swaptmp__';
    var isRealBook = function(b){ return !b.isStamp && !b.isText && !b.isSign; };
    state.books.forEach(function(b){ if (isRealBook(b) && b.shelfId===shelfIdA) b.shelfId=tmp; });
    state.books.forEach(function(b){ if (isRealBook(b) && b.shelfId===shelfIdB) b.shelfId=shelfIdA; });
    state.books.forEach(function(b){ if (isRealBook(b) && b.shelfId===tmp) b.shelfId=shelfIdB; });
    var sA = state.shelfSigns[shelfIdA], sB = state.shelfSigns[shelfIdB];
    if (sB) state.shelfSigns[shelfIdA]=sB; else delete state.shelfSigns[shelfIdA];
    if (sA) state.shelfSigns[shelfIdB]=sA; else delete state.shelfSigns[shelfIdB];
    
    var setA = state.shelfSettings[shelfIdA], setB = state.shelfSettings[shelfIdB];
    if (setB) state.shelfSettings[shelfIdA] = setB; else delete state.shelfSettings[shelfIdA];
    if (setA) state.shelfSettings[shelfIdB] = setA; else delete state.shelfSettings[shelfIdB];

    persist(); renderShelf();
  }
  var reorderSource = null; 

  function addCase(){
    state.cases.push({ id:'c'+(nextCaseNum++), rows:1 });
    persist(); renderShelf();
    requestAnimationFrame(function(){ casesRow.scrollTo({ left: casesRow.scrollWidth, behavior:'smooth' }); });
  }
  function deleteCase(caseId){
    var idx = state.cases.findIndex(x => x.id === caseId);
    if (idx === -1) return;
    var prefix = caseId + '_';
    var hasItems = state.books.some(b => (b.shelfId||'').indexOf(prefix)===0 || b.caseId===caseId)
      || Object.keys(state.shelfSigns).some(k => k.indexOf(prefix)===0);
    if (hasItems && !confirm('この本棚の中身も削除されます。よろしいですか？')) return;
    state.books = state.books.filter(b => (b.shelfId||'').indexOf(prefix)!==0 && b.caseId!==caseId);
    Object.keys(state.shelfSigns).forEach(function(k){ if (k.indexOf(prefix)===0) delete state.shelfSigns[k]; });
    Object.keys(state.shelfSettings).forEach(function(k){ if (k.indexOf(prefix)===0) delete state.shelfSettings[k]; });
    state.cases.splice(idx, 1);
    if (state.cases.length === 0) state.cases.push({ id:'c'+(nextCaseNum++), rows:1 });
    persist(); renderShelf();
  }

  // ★修正：editModeに関係なく常にボタンを作成し、長押しイベントも常にアタッチする
  function attachRowLongPress(unit, block, caseId, rowIndex, addBtn, removeBtn, editBtn){
    var pressTimer = null, startX = 0, startY = 0;

    block.addEventListener('pointerdown', function(e){
      if (e.target.closest('.row-corner-btn')) return;
      startX = e.clientX; startY = e.clientY;
      clearTimeout(pressTimer);
      pressTimer = setTimeout(function(){
        editingCaseId = caseId; 
        ignoreNextClick = true;
        setTimeout(() => ignoreNextClick = false, 500); 
        renderShelf(); 
      }, 500);
    });
    
    block.addEventListener('pointermove', function(e){
      if (Math.abs(e.clientX-startX) > 10 || Math.abs(e.clientY-startY) > 10){
        clearTimeout(pressTimer);
      }
    });
    
    function cancelPress(){ clearTimeout(pressTimer); }
    block.addEventListener('pointerup', cancelPress);
    block.addEventListener('pointercancel', cancelPress);

    block.addEventListener('click', function(e){
      if (ignoreNextClick) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    addBtn.addEventListener('click', function(e){
      e.stopPropagation();
      addRowBelow(caseId, rowIndex);
    });
    
    removeBtn.addEventListener('click', function(e){
      e.stopPropagation();
      deleteCaseRow(caseId, rowIndex);
    });

    editBtn.addEventListener('click', function(e){
      e.stopPropagation();
      openRowSettings(caseId + '_' + rowIndex);
    });
  }

  var currentRowForSettings = null;

  function openRowSettings(shelfId) {
    currentRowForSettings = shelfId;
    var set = state.shelfSettings[shelfId];
    var cCount = set ? set.coverCount : state.coverCount;
    var sCount = set ? set.spineCount : state.spineCount;

    document.getElementById('rs-inpCoverCount').value = cCount;
    document.getElementById('rs-lblCoverCount').textContent = cCount + ' 冊';
    document.getElementById('rs-inpSpineCount').value = sCount;
    document.getElementById('rs-lblSpineCount').textContent = sCount + ' 冊';

    document.getElementById('rowSettingsModal').classList.remove('hidden');
  }

  function applyRowSettingsLive() {
    if (!currentRowForSettings) return;
    if (!state.shelfSettings[currentRowForSettings]) {
      state.shelfSettings[currentRowForSettings] = {};
    }
    state.shelfSettings[currentRowForSettings].coverCount = parseInt(document.getElementById('rs-inpCoverCount').value, 10);
    state.shelfSettings[currentRowForSettings].spineCount = parseInt(document.getElementById('rs-inpSpineCount').value, 10);
    persist();
    renderShelf(); 
  }

  document.getElementById('rs-inpCoverCount').addEventListener('input', function(){
    document.getElementById('rs-lblCoverCount').textContent = this.value + ' 冊';
    applyRowSettingsLive();
  });
  document.getElementById('rs-inpSpineCount').addEventListener('input', function(){
    document.getElementById('rs-lblSpineCount').textContent = this.value + ' 冊';
    applyRowSettingsLive();
  });

  document.getElementById('rs-resetBtn').addEventListener('click', function(){
    if (currentRowForSettings) {
      delete state.shelfSettings[currentRowForSettings];
      persist();
      renderShelf();
      document.getElementById('rowSettingsModal').classList.add('hidden');
      showToast('個別設定を解除しました');
    }
  });

  document.getElementById('rs-closeBtn').addEventListener('click', function(){
    document.getElementById('rowSettingsModal').classList.add('hidden');
  });

  function registerStampHistory(entry){
    var idx = state.stampHistory.findIndex(function(h){
      return h.kind === entry.kind && (h.kind==='image' ? h.cover===entry.cover : h.text===entry.text);
    });
    if (idx !== -1) state.stampHistory.splice(idx, 1);
    state.stampHistory.unshift(entry);
    if (state.stampHistory.length > 24) state.stampHistory.length = 24;
  }
  function addFreeItem(data){
    var caseId = state.cases[0].id;
    var item = Object.assign({ id: uid(), caseId: caseId, x: 0.08, y: 0.05, rot: 0, z: ++globalStampZ }, data);
    state.books.push(item); persist(); renderShelf();
  }
  function addStampWithCover(coverUrl, skipHistory){
    addFreeItem({ isStamp: true, cover: coverUrl, title: 'スタンプ', w: 56, h: 56 });
    if (!skipHistory) registerStampHistory({ kind:'image', cover: coverUrl });
  }
  function addTextSticker(text, skipHistory){
    addFreeItem({ isText: true, title: text, w: 100, h: 32, color: tagColor(text) });
    if (!skipHistory) registerStampHistory({ kind:'text', text: text });
  }
  function readImageFile(file){
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(){ addStampWithCover(reader.result); };
    reader.onerror = function(){ showToast('画像を読み込めませんでした'); };
    reader.readAsDataURL(file);
  }
  document.getElementById('stampFileInput').addEventListener('change', function(){
    readImageFile(this.files[0]); this.value = '';
    document.getElementById('stampMenu').classList.add('hidden');
  });

  // ---- ☻ スタンプメニュー ----
  var stampMenu = document.getElementById('stampMenu');
  document.getElementById('stampMenuBtn').addEventListener('click', function(){
    renderStampHistoryList();
    stampMenu.classList.remove('hidden');
